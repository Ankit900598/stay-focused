# Example only. Copy values into the real, git-ignored .env. Never commit secrets.
# Session auth (Firebase ID tokens). Flag stays OFF until the owner finishes the Firebase
# checklist in PHONECODEX-P0-AUTH-SCAFFOLD.md and the Azure Table multi-instance test passes.
STRLIX_USER_SESSION_AUTH=0
# Owner-provided Firebase project id (token audience). Leave empty until the owner creates it.
STRLIX_FIREBASE_PROJECT_ID=
